input_dir ../electronic
input_format fhi_aims
qp_data ../gw/energy_qp
qp_format energy_qp
screened_dir ../gw/librpa.d
screened_format librpa_wc
output_dir libbse.d
nocc 1
nvirt 4
bse_nstates -1
bse_solver elpa
bse_spin_types singlet
bse_tda tda
bse_use_fine_kgrid 0
wavefunction_gauge native
abs_gauge velocity
out_bse_eigenvectors true
spectrum_broadening_ev 0.10
spectrum_energy_step_ev 0.02
spectrum_energy_min_ev 0
spectrum_energy_max_ev 50
